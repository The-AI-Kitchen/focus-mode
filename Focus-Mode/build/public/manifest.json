{
  "manifest_version": 3,
  "name": "Focus Mode",
  "version": "1.0.0",
  "description": "A focus timer with real-time productivity tracking",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "storage", "activeTab", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"]
}
